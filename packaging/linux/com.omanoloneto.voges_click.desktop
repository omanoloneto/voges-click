[Desktop Entry]
Type=Application
Name=Voges Click
GenericName=Image editor
GenericName[pt]=Editor de imagens
GenericName[pt_BR]=Editor de imagens
GenericName[es]=Editor de imágenes
Comment=Edit pictures in layers and open PSD files
Comment[pt]=Edite imagens em camadas e abra arquivos PSD
Comment[pt_BR]=Edite imagens em camadas e abra arquivos PSD
Comment[es]=Edita imágenes por capas y abre archivos PSD
Exec=voges-click %f
Icon=com.omanoloneto.voges_click
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/vnd.adobe.photoshop;image/x-psd;image/png;image/jpeg;image/bmp;image/x-bmp;image/gif;image/webp;image/tiff;image/vnd.microsoft.icon;image/x-icon;image/x-tga;image/x-targa;
Keywords=photo;image;picture;layers;edit;psd;png;jpg;
Keywords[pt]=foto;imagem;figura;camadas;editar;psd;png;jpg;
Keywords[pt_BR]=foto;imagem;figura;camadas;editar;psd;png;jpg;
Keywords[es]=foto;imagen;capas;editar;psd;png;jpg;
StartupWMClass=com.omanoloneto.voges_click
